async function clearAllTasks() {
  if (saving) return;

  setError("");
  setSaving(true);

  try {
    const response = await fetch("http://localhost:3000/api/todos", {
      method: "DELETE",
    });

    await readResponse(
      response,
      "Could not delete all tasks."
    );

    setTasks([]);
    cancelEditing();

  } catch (error) {
    setError(error.message);
  } finally {
    setSaving(false);
  }
}
